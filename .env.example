# ─── PontLook-SaaS Environment Variables ───
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` to version control.
#
# See: https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# Base URL for metadata, sitemaps, and OG images
# NEXT_PUBLIC_SITE_URL=https://pontlook.com

# Admin Authentication
ADMIN_EMAIL=admin@pontlook.com
ADMIN_PASSWORD_HASH=$2b$12$...   # Generate with: node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD', 12))"
JWT_SECRET=replace-with-a-random-64-char-string

# Future: CRM / email service API key for form submissions
# CRM_API_KEY=your-crm-api-key-here

# Future: Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
