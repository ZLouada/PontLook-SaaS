# ─── PontLook-SaaS Environment Variables ───
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` to version control.
#
# See: https://nextjs.org/docs/app/building-your-application/configuring/environment-variables

# Base URL for metadata, sitemaps, and OG images
# NEXT_PUBLIC_SITE_URL=https://pontlook.com

NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY="your_access_key_here"

# Future: CRM / email service API key for form submissions
# CRM_API_KEY=your-crm-api-key-here

# Future: Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sanity CMS Configuration
NEXT_PUBLIC_SANITY_PROJECT_ID=d95crgxd
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01
# SANITY_API_READ_TOKEN=

# Payload CMS Foundation (Managed PostgreSQL via Neon or Supabase)
# PAYLOAD_SECRET=your_payload_secret_min_32_characters_here
# DATABASE_URI=postgresql://user:password@host:5432/dbname?sslmode=require

# Supabase S3 Cloud Storage Adapter (Optional: Persistent Media in Serverless/Container Deployments)
# SUPABASE_STORAGE_BUCKET=media
# SUPABASE_S3_ACCESS_KEY=your_supabase_s3_access_key
# SUPABASE_S3_SECRET_KEY=your_supabase_s3_secret_key
# SUPABASE_S3_ENDPOINT=https://your-project-id.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=auto
