RewriteEngine On

RewriteCond %{REQUEST_URI} ^/(robots\.txt|sitemap\.xml)$ [NC]
RewriteRule ^ - [L]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Merge www into non-www
RewriteCond %{HTTP_HOST} ^www\.pontlook\.com$ [NC]
RewriteRule ^(.*)$ https://pontlook.com/$1 [R=301,L]

# Root redirect
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ https://pontlook.com/en [R=301,L]

# Handle static Next.js pages with or without trailing slashes
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*?)/?$ $1.html [L]

ErrorDocument 404 /404.html

# Compression (mod_deflate)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser Caching (mod_expires)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set Content-Security-Policy "upgrade-insecure-requests; default-src 'self' 'unsafe-inline' 'unsafe-eval' https:; connect-src 'self' https://api.web3forms.com https://formspree.io https:;"
  Header set X-DNS-Prefetch-Control "on"
  Header set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

FileETag None
Options -Indexes

# Allow robots.txt to serve as plain text
<Files "robots.txt">
  Header unset X-Robots-Tag
  Header set Content-Type "text/plain; charset=utf-8"
</Files>
