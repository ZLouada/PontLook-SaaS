RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 2. Redirect www.pontlook.com to non-www (https://pontlook.com)
RewriteCond %{HTTP_HOST} ^www\.pontlook\.com$ [NC]
RewriteRule ^(.*)$ https://pontlook.com/$1 [R=301,L]

# 3. Direct Root Redirect (/ -> https://pontlook.com/en)
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ https://pontlook.com/en [R=301,L]

# Compression (mod_deflate)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser Caching (mod_expires)

# Security Headers & Cache-Control
Header set X-DNS-Prefetch-Control "on"
Header set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
Header set X-XSS-Protection "1; mode=block"
Header set X-Frame-Options "SAMEORIGIN"
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
Header set Connection keep-alive

FileETag None
Options -Indexes -MultiViews

# Prevent indexing of internal .txt files
<FilesMatch ".txt$">
  Header set X-Robots-Tag "noindex"
</FilesMatch>

<Files "robots.txt">
  Header unset X-Robots-Tag
</Files>

# --- Static Next.js Route Rewrites ---
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

ErrorDocument 404 /404.html