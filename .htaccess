# Apache configuration for Next.js static export on Hostinger
RewriteEngine On

# Explicitly exclude robots.txt and sitemap.xml from redirects
RewriteCond %{REQUEST_URI} ^/(robots\.txt|sitemap\.xml)$ [NC]
RewriteRule ^ - [L]

# 1. Enforce HTTPS (301 Redirect)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 2. Redirect www.pontlook.com to non-www (https://pontlook.com)
RewriteCond %{HTTP_HOST} ^www\.pontlook\.com$ [NC]
RewriteRule ^(.*)$ https://pontlook.com/$1 [R=301,L]

# 3. Direct Root Redirect (/ -> https://pontlook.com/en)
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ https://pontlook.com/en [R=301,L]

# 4. Clean URLs for Next.js Static Export
# Serve existing files directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Serve corresponding .html file cleanly (e.g. /en -> en.html, /ar -> ar.html)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Serve existing directories directly
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 5. Custom 404 Error Page
ErrorDocument 404 /404.html

# 6. Performance & Security Headers (safely guarded for Hostinger compatibility)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>