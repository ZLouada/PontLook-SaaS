RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 2. Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.pontlook\.com$ [NC]
RewriteRule ^(.*)$ https://pontlook.com/$1 [R=301,L]

# Set default index file
DirectoryIndex index.html

# 3. Direct Root '/' Request to /en/
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ https://pontlook.com/en/ [R=301,L]

# 4. Redirect all /ar requests to /en/ (Arabic support removed)
# This clears out old cached browser redirects
RewriteRule ^ar/?$ https://pontlook.com/en/ [R=301,L]
RewriteRule ^ar/(.*)$ https://pontlook.com/en/$1 [R=301,L]

# 5. Enforce trailing slash (since we use Next.js trailingSlash: true)
# If the request is not a file and does not end in a slash, add it!
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ https://pontlook.com/$1/ [R=301,L]

# Compression (mod_deflate)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser Caching (mod_expires)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-DNS-Prefetch-Control "on"
  Header set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

FileETag None
Options -Indexes

# Allow robots.txt to serve as plain text
<Files "robots.txt">
  Header unset X-Robots-Tag
  Header set Content-Type "text/plain; charset=utf-8"
</Files>

# Next.js generates /404/index.html with trailingSlash: true
ErrorDocument 404 /404/index.html