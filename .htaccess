RewriteEngine On

# Exclude robots.txt and sitemap.xml from rewrites
RewriteCond %{REQUEST_URI} ^/(robots\.txt|sitemap\.xml)$ [NC]
RewriteRule ^ - [L]

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 2. Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.pontlook\.com$ [NC]
RewriteRule ^(.*)$ https://pontlook.com/$1 [R=301,L]

# 3. Direct Root '/' Request to https://pontlook.com/en
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ https://pontlook.com/en [R=301,L]

# 4. Redirect all /ar requests to /en (Arabic support removed)
RewriteRule ^ar/?$ https://pontlook.com/en [R=301,L]
RewriteRule ^ar/(.*)$ https://pontlook.com/en/$1 [R=301,L]

# Compression (mod_deflate)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Browser Caching (mod_expires)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-DNS-Prefetch-Control "on"
  Header set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

FileETag None
Options -Indexes -MultiViews

# Disable automatic trailing slash redirects to prevent 503 loops on /ar and /en
DirectorySlash Off

# Allow robots.txt to serve as plain text
<Files "robots.txt">
  Header unset X-Robots-Tag
  Header set Content-Type "text/plain; charset=utf-8"
</Files>

# --- Clean Next.js Static Route Rewrites ---
# If the exact path exists as an HTML file, rewrite it internally
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*?)/?$ $1.html [L]

ErrorDocument 404 /404.html