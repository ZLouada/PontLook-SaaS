# Apache configuration for Next.js static HTML export on Hostinger
RewriteEngine On

# 1. Direct root path / to https://pontlook.com/en (301 Redirect)
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ https://pontlook.com/en [R=301,L]

# 2. Serve existing static files directly (_next/..., images, CSS, JS, robots.txt, sitemap.xml)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 3. Clean URLs for static HTML exports (serves /en from en.html, /ar from ar.html, /en/who-we-are from en/who-we-are.html, etc.)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 4. Serve directory index if present (e.g. /en/ -> /en/index.html)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# 5. Serve existing directories directly
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 6. Custom 404 Error Page
ErrorDocument 404 /404.html